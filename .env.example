# Скопируй в .env
# Ollama на хосте (Win/Mac): http://host.docker.internal:11434 | Linux: http://172.17.0.1:11434
OLLAMA_URL=http://host.docker.internal:11434
# Маленькая модель для контекстного слоя (из `ollama list`): qwen2.5:1.5b | gemma3:4b
LLM_MODEL=qwen2.5:1.5b
# true = без LLM-слоя (только regex+NER, режим fast для всех запросов)
MOCK_MODE=false
